{
  "name": "shitshpejt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && pnpm worker:build",
    "start": "next start",
    "worker:dev": "tsx watch --conditions=react-server src/worker/index.ts",
    "worker:build": "tsup",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres mailpit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:seed:demo": "tsx --conditions=react-server prisma/seed-demo.ts",
    "admin:grant": "tsx --conditions=react-server scripts/admin-grant.ts",
    "worker:start": "node --conditions=react-server dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.26",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/engines",
      "prisma",
      "sharp",
      "@parcel/watcher",
      "@swc/core"
    ]
  }
}
