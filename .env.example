# --- Core ---
APP_ENV=development                     # development | staging | production
DATABASE_URL=postgresql://shitshpejt:shitshpejt@localhost:5432/shitshpejt
BETTER_AUTH_SECRET=                     # openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Optional: Google sign-in (button hidden when unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (console logs emails in dev) ---
EMAIL_PROVIDER=console                  # console | resend
EMAIL_FROM="ShitShpejt <njoftime@shitshpejt.al>"
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=true        # false = no confirmation email, users are logged in right after signup

# --- Images ---
STORAGE_DRIVER=local                    # local | s3
LOCAL_STORAGE_DIR=./.storage
S3_ENDPOINT=                            # e.g. https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                          # public base URL of the bucket

# --- Moderation / analytics ---
MODERATION_MODE=first_n                 # all | first_n | none
MODERATION_TRUST_AFTER=3
ANALYTICS_SALT=                         # random string; used to hash visitor IP+UA daily
LOG_LEVEL=info
